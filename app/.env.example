# VibeFit — environment template
#
# Copy to `.env.local` and fill in the key. `.env.local` is gitignored.
#
#   cp app/.env.example app/.env.local
#
# ─────────────────────────────────────────────────────────────────────────────
# SECURITY NOTE — read before putting a real key in a VITE_ variable
# ─────────────────────────────────────────────────────────────────────────────
# Every `VITE_`-prefixed variable is compiled into the browser bundle. Anyone
# who opens devtools on the running prototype can read it, and a LumiaRouter key
# is billable. That is acceptable for a local academic demo, but it is not safe
# for anything you deploy.
#
# The dev proxy in vite.config.ts therefore supports a second, safer mode:
# set `LUMIA_API_KEY` (no VITE_ prefix) in your shell or .env.local instead.
# The proxy then injects the Authorization header server-side and the key never
# reaches the browser. The UI badge works in both modes.
#
#   VITE_AI_API_KEY=   → sent from the browser (simple, visible in devtools)
#   LUMIA_API_KEY=     → injected by the dev server (recommended)
#
# If both are set, the server-side key wins and the browser sends nothing.

# Base URL for the LumiaRouter OpenAI-compatible API.
VITE_AI_BASE_URL=https://lumiarouter.com/v1

# Leave empty to run entirely on the local deterministic engine.
VITE_AI_API_KEY=

# Model identifier. Must match a model the router exposes.
VITE_AI_MODEL=claude-opus-5-5
